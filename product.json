{
  "name": "Airbnb Number Checker API",
  "brand": "CheckNumber",
  "slug": "airbnb-number-checker-api",
  "repository": "checkernumber/airbnb-number-checker-api",
  "description": "Asynchronous file-based Airbnb checks.",
  "official_site": "https://checknumber.ai",
  "landing_page": "https://checknumber.ai/products/airbnb",
  "canonical_docs": "https://docs.checknumber.ai/airbnb-checker",
  "dashboard": "https://platform.checknumber.ai",
  "base_url": "https://api.checknumber.ai",
  "mode": "async",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "file_format": "text file, one E.164 phone number per line according to task type"
  },
  "products": [
    {
      "task_type": "airbnb",
      "name": "Number Checker",
      "doc_slug": "airbnb-checker",
      "input_kind": "phone",
      "min_numbers": 1000,
      "max_numbers": 100000,
      "result_fields": [
        "number",
        "activated"
      ]
    }
  ],
  "pricing_url": "https://checknumber.ai/pricing",
  "maintainer": "CheckNumber",
  "license": "MIT",
  "last_reviewed": "2026-08-18"
}
